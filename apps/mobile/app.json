{
  "expo": {
    "name": "Brio",
    "slug": "brio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.anonymous.brio"
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/images/brio-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Brio to attach photos as Hermes context.",
          "cameraPermission": "Allow Brio to take a photo and attach it as Hermes context.",
          "microphonePermission": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsAttachmentsWithMaxCount": 10,
              "supportsFileWithMaxCount": 10,
              "supportsImageWithMaxCount": 10,
              "supportsText": true,
              "supportsWebPageWithMaxCount": 1,
              "supportsWebUrlWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["*/*"],
            "multipleShareMimeTypes": ["*/*"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
