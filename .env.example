# Optional local overrides read by the root Makefile.
BRIO_RELAY_ADDR=127.0.0.1:8082

# Connector local development defaults (read by `go run . connect` in
# apps/connect via make dev-connect).
BRIO_AGENT_ID=hermes_dev
# HERMES_API_BASE=http://127.0.0.1:8642
# HERMES_CONTROL_BASE=http://127.0.0.1:9119
# HERMES_CONTROL_TOKEN=replace-with-the-hermes-serve-session-token
# Optional allow-list for @file, @folder, and Git composer references.
# Use the OS path-list separator (: on macOS/Linux, ; on Windows).
# BRIO_COMPOSER_ROOTS=/path/to/project:/path/to/another-project

# Optional relay persistence. If unset, the relay uses in-memory storage.
# BRIO_DATABASE_URL=postgres://user:password@localhost:5432/brio?sslmode=disable

# Relay authentication and browser-origin policy are fail-closed by default.
# `make dev-relay` passes this flag automatically for local development only.
# BRIO_INSECURE_DEV_MODE=true
# Migration-only compatibility for clients that still send `?token=` on the
# WebSocket URL. Leave disabled after upgrading connectors and Mobile.
# BRIO_ALLOW_LEGACY_QUERY_TOKENS=true
#
# Deployed environments must configure verified account auth (future OIDC flow)
# or, as an interim deployment guard, a registration key. The registration key
# must never be embedded in a public app build.
# BRIO_RELAY_ALLOWED_ORIGINS=https://app.brio.dev,https://admin.brio.dev
# BRIO_DEVICE_REGISTRATION_KEY=replace-with-server-side-registration-secret
