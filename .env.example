# Optional local overrides read by the root Makefile.
BRIO_RELAY_ADDR=127.0.0.1:8082

# Connector local development defaults (read by `go run . connect` in
# apps/connect via make dev-connect).
BRIO_AGENT_ID=hermes_dev
# HERMES_API_BASE=http://127.0.0.1:8642
# HERMES_CONTROL_BASE=http://127.0.0.1:9119
# HERMES_CONTROL_TOKEN=replace-with-the-hermes-serve-session-token

# Optional relay persistence. If unset, the relay uses in-memory storage.
# BRIO_DATABASE_URL=postgres://user:password@localhost:5432/brio?sslmode=disable

# Optional relay hardening for deployed environments.
# BRIO_RELAY_ALLOWED_ORIGINS=https://app.brio.dev,https://admin.brio.dev
# BRIO_DEVICE_REGISTRATION_KEY=replace-with-server-side-registration-secret
